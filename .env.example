# --- Supabase Postgres --------------------------------------------------
# Project Settings → Database → Connection string → вкладка "Direct connection".
# Офіційно рекомендований Supabase варіант для персистентних бекендів і
# для `prisma migrate`. Резолвиться тільки в IPv6 (перевірено, що на цій
# мережі IPv6 є) — якщо колись деплой піде на середовище без IPv6
# (наприклад, деякі serverless/CI), там знадобиться Session pooler:
# postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres 
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DATABASE_CA_CERT_PATH=supabase-ca.crt
DATABASE_SSL_REJECT_UNAUTHORIZED=true

PORT=3000
CORS_ORIGINS=http://localhost:4200

JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=8h

# Статичний ключ для машинних клієнтів (n8n) — заголовок X-API-Key на PATCH /jobs/:id.
N8N_API_KEY=change-me-in-every-environment
