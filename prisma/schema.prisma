generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user

  @@map("role")
}

enum JobStatus {
  pending
  success
  failed

  @@map("job_status")
}

enum TaskStatus {
  new
  update
  localization

  @@map("task_status")
}

enum MessageType {
  email
  sms
  web_push
  notification_center
  in_app

  @@map("message_type")
}

enum Board {
  ONBOARDING
  Onboarding_2_not_ready
  CHURN_15

  @@map("board")
}

model Prompt {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("prompts")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique
  /// bcrypt hash, ніколи не зберігати відкритий пароль
  password  String
  role      Role     @default(user)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobs Job[]

  @@map("users")
}

model Rule {
  id        String   @id @default(uuid()) @db.Uuid
  ruleName  String   @map("rule_name")
  ruleSet   Json     @map("rule_set") @db.JsonB
  setType   String[] @map("set_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobRules JobRule[]

  @@map("rules")
}

model Job {
  id              String      @id @default(uuid()) @db.Uuid
  steps           Json        @db.JsonB
  jobType         String      @map("job_type")
  taskStatus      TaskStatus  @map("task_status")
  messageType     MessageType @map("message_type")
  board           Board
  taskDescription String      @map("task_description")
  status          JobStatus   @default(pending)
  runDate         DateTime?   @map("run_date") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Довільний UUID-ідентифікатор з іншої системи. Без FK-зв'язку в
  /// Prisma/БД — просто значення, яке передають і зберігають як є.
  sm String? @db.Uuid

  /// Опціональне посилання на глосарій (за id). Так само без enforced FK —
  /// просто nullable UUID-стовпець, а не Prisma-relation.
  glossaryId String? @map("glossary_id") @db.Uuid

  /// Назва LLM-моделі, якою виконана джоба. Задається лише при створенні
  /// (як jobType/board/sm) — PATCH від n8n її не змінює. Nullable в БД
  /// (старі джоби значення не мають), обов'язкове в CreateJobDto.
  llm String?

  /// Витрати по джобі: ключ (напр. назва моделі) → сума. Завжди починається
  /// як {} при створенні; n8n проставляє/оновлює окремі ключі через PATCH
  /// (сервіс мерджить по ключах, а не перезаписує об'єкт цілком — саме
  /// повне перезаписування знесло entries в glossaries 22.09.2026).
  spend Json @default("{}") @db.JsonB

  jobRules JobRule[]

  runnedById String? @map("runned_by") @db.Uuid
  runnedBy   User?   @relation(fields: [runnedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([runnedById])
  @@map("jobs")
}

/// Явна проміжна таблиця (не implicit m:n), бо implicit-зв'язок у Prisma
/// завжди ставить ON DELETE CASCADE на обидва боки — а нам потрібен
/// Restrict саме на Rule (щоб не можна було видалити правило, поки на
/// нього посилається хоч одна джоба), і Cascade на Job (видалення джоби
/// прибирає її власні зв'язки, це нормально).
model JobRule {
  jobId  String @map("job_id") @db.Uuid
  ruleId String @map("rule_id") @db.Uuid

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([jobId, ruleId])
  @@index([ruleId])
  @@map("job_rules")
}

/// Реальна таблиця глосарія, якою керує адмінка (структурно ідентична Rule:
/// id/назва/jsonb-правила/теги).
model Glossary {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  glossaryName  String   @unique @map("glossary_name")
  allGlossRules Json     @map("all_gloss_rules")
  setType       String[] @default([]) @map("set_type")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("glossaries")
}
